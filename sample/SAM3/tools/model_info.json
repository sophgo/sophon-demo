{
  "model_name": "sam3",
  "full_name": "SAM3 (Segment Anything Model 3 with Concepts)",
  "framework": "pytorch",
  "algorithm": "open_vocabulary_segmentation",
  "total_params": "848M",
  "sub_models": [
    {
      "name": "vision_backbone",
      "description": "ViTDet image encoder + neck for visual feature extraction",
      "model_class": "Sam3DualViTDetNeck (ViT + Neck)",
      "input": {
        "shape": [1, 3, 1008, 1008],
        "dtype": "float32",
        "channel_order": "RGB",
        "value_range": [-1.0, 1.0],
        "dynamic_axes": ["batch"]
      },
      "output": [
        {
          "name": "backbone_fpn",
          "description": "4-level FPN feature maps, each [B, 256, H_i, W_i] where H_i,W_i = [72,72], [36,36], [18,18], [9,9]",
          "shape": [[1, 256, 72, 72], [1, 256, 36, 36], [1, 256, 18, 18], [1, 256, 9, 9]],
          "dtype": "float32"
        },
        {
          "name": "vision_pos_enc",
          "description": "4-level positional encodings corresponding to FPN features",
          "shape": [[1, 256, 72, 72], [1, 256, 36, 36], [1, 256, 18, 18], [1, 256, 9, 9]],
          "dtype": "float32"
        }
      ],
      "architecture": {
        "vit": {
          "img_size": 1008,
          "patch_size": 14,
          "patch_grid": [72, 72],
          "embed_dim": 1024,
          "depth": 32,
          "num_heads": 16,
          "head_dim": 64,
          "mlp_ratio": 4.625,
          "mlp_hidden": 4736,
          "global_att_blocks": [7, 15, 23, 31],
          "window_att_blocks": [0,1,2,3,4,5,6,8,9,10,11,12,13,14,16,17,18,19,20,21,22,24,25,26,27,28,29,30],
          "window_size": 24,
          "use_rope": true,
          "use_abs_pos": true,
          "tile_abs_pos": true,
          "retain_cls_token": false,
          "ln_pre": true,
          "ln_post": false,
          "norm_layer": "LayerNorm",
          "act_layer": "GELU",
          "block_structure": {
            "norm1": "LayerNorm(1024)",
            "attn": "MultiHeadAttention(1024, 16 heads, qkv_bias)",
            "ls1": "LayerScale(init=1e-6)",
            "norm2": "LayerNorm(1024)",
            "mlp": "Linear(1024→4736) + GELU + Linear(4736→1024)",
            "ls2": "LayerScale(init=1e-6)",
            "dropout": 0.0
          }
        },
        "neck": {
          "type": "Sam3DualViTDetNeck",
          "d_model": 256,
          "scale_factors": [4.0, 2.0, 1.0, 0.5],
          "num_feature_levels": 4,
          "output_channels": 256
        }
      },
      "ops": [
        "Conv2d", "LayerNorm", "GELU", "Linear", "MultiHeadAttention",
        "RoPE", "DropPath", "Softmax", "LayerScale",
        "PatchEmbed", "WindowAttention", "GlobalAttention"
      ]
    },
    {
      "name": "text_encoder",
      "description": "Visual-language text encoder for text prompt conditioning",
      "model_class": "VETextEncoder",
      "input": {
        "shape": [1, "variable"],
        "dtype": "int64 (token_ids)",
        "description": "BPE tokenized text, variable length"
      },
      "output": {
        "name": "language_features",
        "shape": [1, "variable", 256],
        "dtype": "float32"
      },
      "architecture": {
        "type": "VETextEncoder",
        "d_model": 256,
        "width": 1024,
        "heads": 16,
        "layers": 24,
        "tokenizer": "SimpleTokenizer (BPE)"
      },
      "ops": [
        "Embedding", "LayerNorm", "MultiHeadAttention",
        "Linear", "GELU", "Softmax"
      ]
    },
    {
      "name": "grounding_model",
      "description": "DETR-based grounding model (transformer + segmentation head)",
      "model_class": "Sam3Image",
      "input": {
        "visual_features": {"shape": ["variable", 256, "H", "W"], "dtype": "float32"},
        "visual_pos_enc": {"shape": ["variable", 256, "H", "W"], "dtype": "float32"},
        "language_features": {"shape": ["variable", "N_text", 256], "dtype": "float32"},
        "geometric_prompt": {"description": "Points/boxes prompts"}
      },
      "output": [
        {"name": "pred_logits", "shape": [1, 200, 1], "dtype": "float32", "description": "Detection scores (logits)"},
        {"name": "pred_boxes", "shape": [1, 200, 4], "dtype": "float32", "description": "Predicted boxes in cxcywh format (normalized 0~1)"},
        {"name": "pred_masks", "shape": [1, 200, "H", "W"], "dtype": "float32", "description": "Predicted mask logits"},
        {"name": "presence_logit_dec", "shape": [1, 200], "dtype": "float32", "description": "Presence token logits"}
      ],
      "architecture": {
        "transformer_encoder": {"layers": 6, "d_model": 256, "num_heads": 8, "dim_feedforward": 2048},
        "transformer_decoder": {"layers": 6, "d_model": 256, "num_heads": 8, "num_queries": 200, "box_refine": true, "presence_token": true},
        "segmentation_head": {"type": "UniversalSegmentationHead", "upsampling_stages": 3, "hidden_dim": 256},
        "geometry_encoder": {"type": "SequenceGeometryEncoder", "num_layers": 3, "d_model": 256}
      },
      "ops": [
        "MultiHeadAttention", "LayerNorm", "Linear", "ReLU",
        "GELU", "Softmax", "Sigmoid", "Conv2d",
        "Interpolate", "MatMul", "Add", "Mul"
      ]
    }
  ],
  "preprocess": {
    "resize": [1008, 1008],
    "mean": [0.5, 0.5, 0.5],
    "std": [0.5, 0.5, 0.5],
    "bgr_to_rgb": true,
    "input_range": [0, 255],
    "normalized_range": [0, 1],
    "note": "Image is first resized to 1008x1008, then ToDtype(float32, scale=True), then Normalize(mean=[0.5]*3, std=[0.5]*3). Equivalent to: (pixel/255.0 - 0.5) / 0.5 = pixel/127.5 - 1.0"
  },
  "postprocess": {
    "description": "Boxes are converted from cxcywh normalized to xyxy absolute coordinates. Masks are upsampled to original image size and thresholded at 0.5. Scores are filtered by confidence_threshold (default 0.5).",
    "steps": [
      "Sigmoid on pred_logits → confidence scores",
      "Sigmoid on presence_logit_dec → presence score",
      "Multiply scores * presence_score → joint scores",
      "Filter by confidence_threshold > 0.5",
      "Box cxcywh → xyxy, rescale to original image size",
      "Mask logits → sigmoid → upsampled to original image size"
    ]
  },
  "ref_sample": "sample/SAM2",
  "notes": {
    "complexity": "SAM3 is extremely complex (848M params). For practical porting, split into sub-models: (1) vision_backbone (ViT+Neck), (2) grounding_model (DETR+SegHead). Text encoder may not be ONNX-exportable due to tokenizer. Consider pre-computing text embeddings on CPU and passing to grounding model.",
    "challenges": [
      "Model weights require HuggingFace access approval (facebook/sam3)",
      "Text tokenizer (BPE) not ONNX-friendly - may need to pre-compute text features",
      "Dynamic control flow (torch._assert_async, unique()) not ONNX compatible",
      "Custom fused ops (addmm_act, perflib) may need replacement",
      "Model size may exceed BM1684X memory - may need to split into multiple bmodels",
      "RoPE with complex number operations may have ONNX export issues"
    ],
    "porting_plan": [
      "Phase 1: Export ViT backbone + neck to ONNX (heaviest component, ~400M params)",
      "Phase 2: Export DETR transformer + segmentation head to ONNX",
      "Phase 3: Text features pre-computed on CPU, sent to grounding model",
      "Phase 4: Compile to bmodel for BM1684X",
      "Phase 5: Python inference demo"
    ]
  }
}
